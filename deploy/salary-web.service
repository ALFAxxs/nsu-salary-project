# /etc/systemd/system/salary-web.service
[Unit]
Description=Salary System - Gunicorn
After=network.target postgresql.service redis.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/salary_system
Environment="DJANGO_SETTINGS_MODULE=config.settings.prod"
# systemd creates /run/salary/ (owned by User:Group above) right before
# start and removes it on stop — binding straight to /run/salary.sock
# instead fails, since /run/ itself is root-owned and www-data has no
# permission to create a new file there.
RuntimeDirectory=salary
ExecStart=/opt/salary_system/.venv/bin/gunicorn config.wsgi:application \
    --workers 4 --bind unix:/run/salary/salary.sock --timeout 120 \
    --access-logfile /opt/salary_system/logs/gunicorn-access.log \
    --error-logfile /opt/salary_system/logs/gunicorn-error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
